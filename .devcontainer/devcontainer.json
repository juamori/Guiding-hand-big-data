{
  // Guiding Hand — Big Data (FIAP GS 2026)
  // Ambiente Linux do GitHub Codespaces para rodar o Airflow 3 SEM Docker no seu computador.
  // Na criação: instala PostgreSQL 15 e Airflow 3.0.6 (scripts/codespaces/instalar.sh).
  // A cada abertura: sobe PostgreSQL e Airflow (scripts/codespaces/iniciar.sh).
  "name": "Guiding Hand - Big Data",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "containerEnv": {
    "GH_CODESPACE_CONFIG": "1",
    "GH_ESTADO": "/workspaces/.guiding-hand-estado"
  },
  "postCreateCommand": "bash scripts/codespaces/instalar.sh",
  "postStartCommand": "bash scripts/codespaces/iniciar.sh --em-segundo-plano",
  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": { "label": "Airflow 3", "onAutoForward": "notify" },
    "8000": { "label": "Tela do MVP", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/codespaces.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
